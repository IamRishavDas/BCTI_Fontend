{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "bcti",
  "version": "0.1.1",
  "identifier": "com.iamrishavdas",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "BCTI",
        "maximized": true,
        "resizable": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": true,
      "endpoints": [
        "https://github.com/IamRishavDas/BCTI_Fontend/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc3ODcyMTM1QUMyNjI2NzAKUldSd0ppYXNOU0dIZDVUc0tLdHc3T1dPejZKZVNZbjMxUi83WmQrZDlJKzhwemdERzRqUmkxM0QK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}